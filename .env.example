# Zone géographique du site : "cagnes" (Côte d'Azur, défaut) ou "bonneval".
# Voir docs/DEMENAGEMENT-BONNEVAL.md
NEXT_PUBLIC_LOCATION=cagnes

# Formulaire de devis (envoi par email via Resend, https://resend.com)
# Sans RESEND_API_KEY, le formulaire ouvre l'email pré-rempli (comportement de secours).
RESEND_API_KEY=
DEVIS_TO_EMAIL=pheulpin.plomberie@gmail.com
# Expéditeur vérifié sur Resend. Par défaut : "LP Plomberie <onboarding@resend.dev>"
# (cet expéditeur de test n'envoie qu'à l'email du compte Resend)
DEVIS_FROM_EMAIL=
